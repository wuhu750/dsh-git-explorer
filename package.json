{
  "name": "dsh-git-explorer",
  "version": "0.2.0",
  "description": "Git workbench for DSH: commit graph, status, history, branches, tags, stashes, hunk staging, blame, line history and diffs in the sidebar and in a conversation tab.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "scripts/smoke.mjs",
    "scripts/graph-test.mjs",
    "scripts/render-test.mjs",
    "scripts/route-test.mjs",
    "LICENSE",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs && node scripts/graph-test.mjs && node scripts/render-test.mjs && node scripts/route-test.mjs",
    "test:graph": "node scripts/graph-test.mjs",
    "test:render": "node scripts/render-test.mjs",
    "test:route": "node scripts/route-test.mjs",
    "pack": "npm pack"
  },
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "git",
    "scm",
    "diff",
    "blame",
    "commit-graph",
    "tags",
    "stash",
    "hunks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuhu750/dsh-git-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/wuhu750/dsh-git-explorer/issues"
  },
  "homepage": "https://github.com/wuhu750/dsh-git-explorer#readme"
}
